engine-strict=true
# npm 10.9.x's arborist crashes resolving vitest 4's peer set
# ("Cannot read properties of null (reading 'edgesOut')"). vitest 4 is the
# correct pairing for vite 8 — vitest 3 bundles its own rollup-typed vite copy
# and breaks `npm run check`. Remove this once npm >= 11 is the local default.
legacy-peer-deps=true
